# Hermes Mission Control Environment Variables

# Dashboard URL (where Hermes is running)
HERMES_DASHBOARD_URL=http://localhost:9119

# Auth Bypass (optional - set if you have a token)
# HERMES_AUTH_TOKEN=your_session_token

# OAuth Provider (for bypass mode)
HERMES_AUTH_PROVIDER=telegram

# Profile (default or leadenginer)
HERMES_AUTH_PROFILE=default

# Raum API Server URL
API_BASE_URL=http://localhost:3001
