# Hermes Mission Control Environment Variables
# Copy to .env.local and update values

# Dashboard URL (where Hermes is running)
HERMES_DASHBOARD_URL=http://localhost:9119

# Raum API Server URL
API_BASE_URL=http://localhost:3001

# Optional: Access code for Raum API (if enabled)
# ACCESS_CODE=your_access_code

# Optional: Port overrides
# PORT=3000
# RUANG_PORT=3001
